  "dailyCare_screenTitle": "Daily Care",
  "@dailyCare_screenTitle": {
    "description": "Title for the daily care screen"
  },
  "dailyCare_introduction": "Daily care is very important for pregnant women to maintain their health and the health of their baby. Here is a guide for daily care during pregnancy:",
  "@dailyCare_introduction": {
    "description": "Introduction text on the importance of daily care for pregnant women"
  },
  "dailyCare_item1_title": "Eat a Variety of Foods",
  "@dailyCare_item1_title": {
    "description": "Title for the first care item"
  },
  "dailyCare_item1_content1": "Consume a balanced diet: Carbohydrates, Protein, Vegetables, Fruits.",
  "@dailyCare_item1_content1": {
    "description": "Content 1 for the first care item"
  },
  "dailyCare_item1_content2": "Take ==Iron Supplements== daily.",
  "@dailyCare_item1_content2": {
    "description": "Content 2 for the first care item"
  },
  "dailyCare_item1_content3": "Limit sugar and salt intake.",
  "@dailyCare_item1_content3": {
    "description": "Content 3 for the first care item"
  },
  "dailyCare_item1_content4": "Drink 8-12 glasses of water per day.",
  "@dailyCare_item1_content4": {
    "description": "Content 4 for the first care item"
  },
  "dailyCare_item2_title": "Maintain Personal Hygiene",
  "@dailyCare_item2_title": {
    "description": "Title for the second care item"
  },
  "dailyCare_item2_content1": "Wash hands with soap and running water.",
  "@dailyCare_item2_content1": {
    "description": "Content 1 for the second care item"
  },
  "dailyCare_item2_content2": "Bathe and brush your teeth twice a day.",
  "@dailyCare_item2_content2": {
    "description": "Content 2 for the second care item"
  },
  "dailyCare_item2_content3": "Shampoo your hair every 2 days.",
  "@dailyCare_item2_content3": {
    "description": "Content 3 for the second care item"
  },
  "dailyCare_item2_content4": "Keep your breasts and intimate areas clean.",
  "@dailyCare_item2_content4": {
    "description": "Content 4 for the second care item"
  },
  "dailyCare_item2_content5": "Change clothes and underwear regularly.",
  "@dailyCare_item2_content5": {
    "description": "Content 5 for the second care item"
  },
  "dailyCare_item3_title": "Get Enough Rest",
  "@dailyCare_item3_title": {
    "description": "Title for the third care item"
  },
  "dailyCare_item3_content1": "Sleep 6-7 hours at night.",
  "@dailyCare_item3_content1": {
    "description": "Content 1 for the third care item"
  },
  "dailyCare_item3_content2": "Rest for 1-2 hours during the day.",
  "@dailyCare_item3_content2": {
    "description": "Content 2 for the third care item"
  },
  "dailyCare_item4_title": "Fetal Stimulation",
  "@dailyCare_item4_title": {
    "description": "Title for the fourth care item"
  },
  "dailyCare_item4_content1": "Touch the mother''s belly.",
  "@dailyCare_item4_content1": {
    "description": "Content 1 for the fourth care item"
  },
  "dailyCare_item4_content2": "Talk to the baby.",
  "@dailyCare_item4_content2": {
    "description": "Content 2 for the fourth care item"
  },
  "dailyCare_item4_content3": "Read books to the baby.",
  "@dailyCare_item4_content3": {
    "description": "Content 3 for the fourth care item"
  },
  "dailyCare_item4_content4": "Do it together with your husband.",
  "@dailyCare_item4_content4": {
    "description": "Content 4 for the fourth care item"
  },
  "dailyCare_item5_title": "Physical Activity and Exercise",
  "@dailyCare_item5_title": {
    "description": "Title for the fifth care item"
  },
  "dailyCare_item5_content1": "Adjust activities to your pregnancy condition.",
  "@dailyCare_item5_content1": {
    "description": "Content 1 for the fifth care item"
  },
  "dailyCare_item5_content2": "Do pregnancy exercises as recommended.",
  "@dailyCare_item5_content2": {
    "description": "Content 2 for the fifth care item"
  },
  "dailyCare_item5_content3": "The type of exercise should match your pregnancy stage.",
  "@dailyCare_item5_content3": {
    "description": "Content 3 for the fifth care item"
  },
  "dailyCare_item6_title": "Intimacy with Your Partner",
  "@dailyCare_item6_title": {
    "description": "Title for the sixth care item"
  },
  "dailyCare_item6_content1": "It can be done if the pregnancy is healthy.",
  "@dailyCare_item6_content1": {
    "description": "Content 1 for the sixth care item"
  },
  "dailyCare_item6_content2": "Consult with a healthcare provider if there are any concerns.",
  "@dailyCare_item6_content2": {
    "description": "Content 2 for the sixth care item"
  },
  "dailyCare_tipsTitle": "Additional Tips",
  "@dailyCare_tipsTitle": {
    "description": "Title for the additional tips section"
  },
  "dailyCare_tipsContent": "Always consult your doctor or midwife about the appropriate care during pregnancy. Each pregnancy is unique and may require special attention.",
  "@dailyCare_tipsContent": {
    "description": "Content for the additional tips"
  },
  "dailyCare_moreTipsButton": "See More Tips",
  "@dailyCare_moreTipsButton": {
    "description": "Text for the see more tips button"
  },
  "dailyCare_moreTipsTitle": "Additional Tips for Daily Care",
  "@dailyCare_moreTipsTitle": {
    "description": "Title for the additional tips modal"
  },
  "dailyCare_moreTip1": "Use moisturizer to prevent stretch marks on your belly and breasts.",
  "@dailyCare_moreTip1": {
    "description": "Additional tip 1"
  },
  "dailyCare_moreTip2": "Do light foot massages to reduce swelling.",
  "@dailyCare_moreTip2": {
    "description": "Additional tip 2"
  },
  "dailyCare_moreTip3": "Choose comfortable, non-restrictive clothing.",
  "@dailyCare_moreTip3": {
    "description": "Additional tip 3"
  },
  "dailyCare_moreTip4": "Avoid wearing high heels to prevent back pain.",
  "@dailyCare_moreTip4": {
    "description": "Additional tip 4"
  },
  "dailyCare_moreTip5": "Eat fiber-rich foods to prevent constipation.",
  "@dailyCare_moreTip5": {
    "description": "Additional tip 5"
  },
  "dailyCare_moreTip6": "Practice deep breathing techniques for relaxation.",
  "@dailyCare_moreTip6": {
    "description": "Additional tip 6"
  },
  "dailyCare_moreTip7": "Maintain good posture while sitting and standing.",
  "@dailyCare_moreTip7": {
    "description": "Additional tip 7"
  },
  "dailyCare_moreTip8": "Avoid lifting heavy objects during pregnancy.",
  "@dailyCare_moreTip8": {
    "description": "Additional tip 8"
  },
  "dailyCare_moreTip9": "Do light stretches every morning to increase flexibility.",
  "@dailyCare_moreTip9": {
    "description": "Additional tip 9"
  },
  "dailyCare_moreTip10": "Listen to calming music to reduce stress.",
  "@dailyCare_moreTip10": {
    "description": "Additional tip 10"
  },
  "dailyCare_referencesTitle": "References",
  "@dailyCare_referencesTitle": {
    "description": "Title for the references section"
  },
