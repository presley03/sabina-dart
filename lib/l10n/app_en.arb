  "avoidScreen_alcohol_content": "Drinking alcohol during pregnancy can lead to birth defects, growth issues, and brain development problems in the baby.",
  "@avoidScreen_alcohol_content": {
    "description": "Explanation of the dangers of consuming alcohol during pregnancy"
  },
  "avoidScreen_smoking_title": "Smoking",
  "@avoidScreen_smoking_title": {
    "description": "Title for the smoking item"
  },
  "avoidScreen_smoking_content": "Smoking during pregnancy increases the risk of premature birth, low birth weight, and respiratory problems in the baby. It also raises the risk of Sudden Infant Death Syndrome (==SIDS==).",
  "@avoidScreen_smoking_content": {
    "description": "Explanation of the dangers of smoking during pregnancy"
  },
  "avoidScreen_caffeine_title": "Excessive Caffeine Intake",
  "@avoidScreen_caffeine_title": {
    "description": "Title for the excessive caffeine item"
  },
  "avoidScreen_caffeine_content": "Excessive caffeine intake during pregnancy can increase the risk of miscarriage and low birth weight. It is recommended to limit caffeine intake to a maximum of ==200 mg per day== (about one cup of coffee).",
  "@avoidScreen_caffeine_content": {
    "description": "Explanation of the dangers of excessive caffeine intake during pregnancy"
  },
  "avoidScreen_drugs_title": "Exposure to Illegal Drugs",
  "@avoidScreen_drugs_title": {
    "description": "Title for the illegal drugs item"
  },
  "avoidScreen_drugs_content": "The use of illegal drugs like cocaine, amphetamines, and heroin during pregnancy can cause premature birth, birth defects, and behavioral and developmental problems in the baby.",
  "@avoidScreen_drugs_content": {
    "description": "Explanation of the dangers of illegal drug exposure during pregnancy"
  },
  "avoidScreen_rawFood_title": "Raw or Undercooked Food",
  "@avoidScreen_rawFood_title": {
    "description": "Title for the raw or undercooked food item"
  },
  "avoidScreen_rawFood_content": "Pregnant women should avoid consuming raw or undercooked food like sushi, raw eggs, undercooked meat, and unpasteurized milk as they can lead to bacterial infections such as listeria.",
  "@avoidScreen_rawFood_content": {
    "description": "Explanation of the dangers of consuming raw or undercooked food during pregnancy"
  },
  "avoidScreen_highMercuryFish_title": "High-Mercury Fish Consumption",
  "@avoidScreen_highMercuryFish_title": {
    "description": "Title for the high-mercury fish item"
  },
  "avoidScreen_highMercuryFish_content": "Fish that contain high levels of mercury, such as shark, swordfish, and bluefin tuna, can affect the baby''s nervous system development. Pregnant women should opt for low-mercury fish.",
  "@avoidScreen_highMercuryFish_content": {
    "description": "Explanation of the dangers of consuming high-mercury fish during pregnancy"
  },
  "avoidScreen_chemicals_title": "Use of Harmful Chemicals",
  "@avoidScreen_chemicals_title": {
    "description": "Title for the harmful chemicals item"
  },
  "avoidScreen_chemicals_content": "Avoid using harsh household chemicals like ammonia-based cleaners, bleach, and insecticides. Exposure to these chemicals can pose risks to the health of the mother and baby.",
  "@avoidScreen_chemicals_content": {
    "description": "Explanation of the dangers of using harmful chemicals during pregnancy"
  },
  "avoidScreen_heavyLifting_title": "Lifting Heavy Objects",
  "@avoidScreen_heavyLifting_title": {
    "description": "Title for the heavy lifting item"
  },
  "avoidScreen_heavyLifting_content": "Pregnant women should avoid lifting heavy objects as it can cause back injuries, muscle strain, and increase the risk of miscarriage, especially in early pregnancy.",
  "@avoidScreen_heavyLifting_content": {
    "description": "Explanation of the dangers of lifting heavy objects during pregnancy"
  },
  "avoidScreen_lackOfRest_title": "Ignoring Adequate Rest",
  "@avoidScreen_lackOfRest_title": {
    "description": "Title for the lack of rest item"
  },
  "avoidScreen_lackOfRest_content": "Pregnancy causes significant changes in the body, and adequate rest is essential. Lack of sleep can lead to stress, fatigue, and potential complications such as high blood pressure or ==preeclampsia==.",
  "@avoidScreen_lackOfRest_content": {
    "description": "Explanation of the dangers of lack of rest during pregnancy"
  },
  "avoidScreen_stress_title": "Excessive Stress",
  "@avoidScreen_stress_title": {
    "description": "Title for the excessive stress item"
  },
  "avoidScreen_stress_content": "Excessive stress can affect the health of both the pregnant woman and the baby. High levels of stress during pregnancy can increase the risk of premature birth, low birth weight, and behavioral issues in the child later in life.",
  "@avoidScreen_stress_content": {
    "description": "Explanation of the dangers of excessive stress during pregnancy"
  },
  "avoidScreen_tips_title": "Healthy Pregnancy Tips",
  "@avoidScreen_tips_title": {
    "description": "Title for the healthy pregnancy tips section"
  },
  "avoidScreen_tips_content": "To maintain a healthy pregnancy, always consult with your doctor or midwife about the right lifestyle and diet. If you have any concerns or questions, don't hesitate to contact a healthcare professional.",
  "@avoidScreen_tips_content": {
    "description": "Content for healthy pregnancy tips"
  },
  "avoidScreen_moreTips": "See More Tips",
  "@avoidScreen_moreTips": {
    "description": "Text for the see more tips button"
  },
  "avoidScreen_additionalTips_title": "Additional Tips for a Healthy Pregnancy",
  "@avoidScreen_additionalTips_title": {
    "description": "Title for the additional tips section"
  },
  "avoidScreen_additionalTip1": "Eat foods rich in folic acid, such as leafy greens and legumes.",
  "@avoidScreen_additionalTip1": {
    "description": "Additional tip 1"
  },
  "avoidScreen_additionalTip2": "Engage in light exercise like walking or prenatal yoga.",
  "@avoidScreen_additionalTip2": {
    "description": "Additional tip 2"
  },
  "avoidScreen_additionalTip3": "Avoid exposure to cigarette smoke and air pollution.",
  "@avoidScreen_additionalTip3": {
    "description": "Additional tip 3"
  },
  "avoidScreen_additionalTip4": "Have regular prenatal check-ups as recommended by your doctor or midwife.",
  "@avoidScreen_additionalTip4": {
    "description": "Additional tip 4"
  },
  "avoidScreen_additionalTip5": "Maintain hygiene by washing your hands and bathing regularly.",
  "@avoidScreen_additionalTip5": {
    "description": "Additional tip 5"
  },
  "avoidScreen_additionalTip6": "Use moisturizers to prevent stretch marks.",
  "@avoidScreen_additionalTip6": {
    "description": "Additional tip 6"
  },
  "avoidScreen_additionalTip7": "Take prenatal supplements as advised by your doctor.",
  "@avoidScreen_additionalTip7": {
    "description": "Additional tip 7"
  },
  "avoidScreen_additionalTip8": "Practice relaxation techniques to reduce stress.",
  "@avoidScreen_additionalTip8": {
    "description": "Additional tip 8"
  },
  "avoidScreen_additionalTip9": "Sleep on your left side to improve blood circulation to the baby.",
  "@avoidScreen_additionalTip9": {
    "description": "Additional tip 9"
  },
  "avoidScreen_additionalTip10": "Avoid using jacuzzis or saunas as they can raise body temperature.",
  "@avoidScreen_additionalTip10": {
    "description": "Additional tip 10"
  },
  "avoidScreen_additionalTip11": "Ensure your vaccinations are up to date as recommended by your doctor.",
  "@avoidScreen_additionalTip11": {
    "description": "Additional tip 11"
  },
  "avoidScreen_additionalTip12": "Drink enough water, at least 8 glasses per day.",
  "@avoidScreen_additionalTip12": {
    "description": "Additional tip 12"
  },
  "avoidScreen_additionalTip13": "Wear comfortable, non-restrictive clothing.",
  "@avoidScreen_additionalTip13": {
    "description": "Additional tip 13"
  },
  "avoidScreen_additionalTip14": "Have regular dental check-ups to prevent gum problems.",
  "@avoidScreen_additionalTip14": {
    "description": "Additional tip 14"
  },
