        "trimesterThree_title": "Third Trimester",
        "@trimesterThree_title": {
          "description": "Title for the third trimester page"
        },
        
        "trimesterThree_header": "Third Trimester of Pregnancy",
        "@trimesterThree_header": {
          "description": "Header title for the third trimester page"
        },
      
        "trimesterThree_intro": "The third trimester lasts from week 28 to week 40. This is the final phase of pregnancy where the baby continues to grow and develop, preparing for birth. During this period, the physical and emotional changes in the mother become more prominent, and she may experience more physical discomfort due to the growing baby.",
        "@trimesterThree_intro": {
          "description": "Intro paragraph explaining the third trimester"
        },
      
        "trimesterThree_weeklyDevelopment_title": "Weekly Fetal Development",
        "@trimesterThree_weeklyDevelopment_title": {
          "description": "Title for the weekly fetal development section"
        },
      
        "trimesterThree_week28_29": "Week 28-29",
        "@trimesterThree_week28_29": {
          "description": "Label for week 28-29"
        },
      
        "trimesterThree_week28_29_desc": "Fetal size: Around 38-40 cm, weighing about 1-1.3 kg. The baby continues gaining weight, and rapid development occurs in the lungs and brain. The eyes can blink and respond to light. Fat begins to accumulate under the skin, giving the baby a fuller appearance.",
        "@trimesterThree_week28_29_desc": {
          "description": "Description of fetal development during week 28-29"
        },
      
        "trimesterThree_week30_31": "Week 30-31",
        "@trimesterThree_week30_31": {
          "description": "Label for week 30-31"
        },
      
        "trimesterThree_week30_31_desc": "Fetal size: Around 40-42 cm, weighing about 1.4-1.6 kg. The baby becomes more active, and the mother may feel stronger kicks. Hearing is well developed, allowing the baby to respond to sounds both inside and outside the womb.",
        "@trimesterThree_week30_31_desc": {
          "description": "Description of fetal development during week 30-31"
        },
      
        "trimesterThree_week32_33": "Week 32-33",
        "@trimesterThree_week32_33": {
          "description": "Label for week 32-33"
        },
      
        "trimesterThree_week32_33_desc": "Fetal size: Around 42-44 cm, weighing about 1.8-2 kg. The baby''s immune system begins to develop, and it may suck its thumb. The baby is likely to settle into a more stable position, often head-down in preparation for birth.",
        "@trimesterThree_week32_33_desc": {
          "description": "Description of fetal development during week 32-33"
        },
      
        "trimesterThree_week34_35": "Week 34-35",
        "@trimesterThree_week34_35": {
          "description": "Label for week 34-35"
        },
      
        "trimesterThree_week34_35_desc": "Fetal size: Around 45-47 cm, weighing about 2.2-2.5 kg. The baby gains weight rapidly, and the lungs are almost fully mature. If born prematurely at this stage, the baby might still need help breathing.",
        "@trimesterThree_week34_35_desc": {
          "description": "Description of fetal development during week 34-35"
        },
      
        "trimesterThree_week36_37": "Week 36-37",
        "@trimesterThree_week36_37": {
          "description": "Label for week 36-37"
        },
      
        "trimesterThree_week36_37_desc": "Fetal size: Around 48-50 cm, weighing about 2.7-3 kg. The baby is usually in a head-down position, and space inside the womb becomes more limited, resulting in slower, gentler movements.",
        "@trimesterThree_week36_37_desc": {
          "description": "Description of fetal development during week 36-37"
        },
      
        "trimesterThree_week38_39": "Week 38-39",
        "@trimesterThree_week38_39": {
          "description": "Label for week 38-39"
        },
      
        "trimesterThree_week38_39_desc": "Fetal size: Around 50-52 cm, weighing about 3-3.3 kg. The baby is nearly fully developed and ready for birth. Vital organs such as the lungs and brain are fully formed, and the baby continues to gain weight.",
        "@trimesterThree_week38_39_desc": {
          "description": "Description of fetal development during week 38-39"
        },
      
        "trimesterThree_week40": "Week 40",
        "@trimesterThree_week40": {
          "description": "Label for week 40"
        },
      
        "trimesterThree_week40_desc": "Fetal size: Around 50-55 cm, weighing about 3.5-4 kg. The baby is fully developed and ready for birth. Movements may slow down due to limited space in the womb, and the mother may experience labor signs such as contractions or mucus discharge.",
        "@trimesterThree_week40_desc": {
          "description": "Description of fetal development during week 40"
        },
      
        "trimesterThree_maternalChanges_title": "Changes in the Mother",
        "@trimesterThree_maternalChanges_title": {
          "description": "Title for changes in the mother during the third trimester"
        },
      
        "trimesterThree_maternalChanges_28_30": "Weeks 28-30: The mother may feel the need to urinate more frequently due to the baby''s size pressing on the bladder. Fatigue may return, and sleep may be disrupted due to discomfort.",
        "@trimesterThree_maternalChanges_28_30": {
          "description": "Changes in the mother during weeks 28-30"
        },
      
        "trimesterThree_maternalChanges_31_34": "Weeks 31-34: Many pregnant women experience mild shortness of breath as the expanding uterus presses on the diaphragm. Swelling in the legs and ankles is also common, especially after standing for long periods.",
        "@trimesterThree_maternalChanges_31_34": {
          "description": "Changes in the mother during weeks 31-34"
        },
      
        "trimesterThree_maternalChanges_35_37": "Weeks 35-37: The mother may start feeling Braxton Hicks contractions, which are irregular contractions that prepare the body for labor. Back pain may worsen as the baby moves lower into the pelvis.",
        "@trimesterThree_maternalChanges_35_37": {
          "description": "Changes in the mother during weeks 35-37"
        },
      
        "trimesterThree_maternalChanges_38_40": "Weeks 38-40: The mother may feel increased pressure in the pelvic area, causing discomfort. Labor signs such as regular contractions or water breaking may occur.",
        "@trimesterThree_maternalChanges_38_40": {
          "description": "Changes in the mother during weeks 38-40"
        },
      
        "trimesterThree_commonComplaints_title": "Common Complaints",
        "@trimesterThree_commonComplaints_title": {
          "description": "Title for common complaints experienced by the mother"
        },
      
        "trimesterThree_commonComplaints_backPain": "Lower Back Pain: As the baby grows larger, many mothers experience pain in the lower back and pelvis.",
        "@trimesterThree_commonComplaints_backPain": {
          "description": "Common complaint related to lower back pain"
        },
      
        "trimesterThree_commonComplaints_sleepProblems": "Difficulty Sleeping: Finding a comfortable sleeping position becomes harder as the belly grows. Many mothers also experience leg cramps at night.",
        "@trimesterThree_commonComplaints_sleepProblems": {
          "description": "Common complaint related to sleep problems"
        },
      
        "trimesterThree_commonComplaints_frequentUrination": "Frequent Urination: The growing baby presses on the bladder, making the mother urinate more frequently.",
        "@trimesterThree_commonComplaints_frequentUrination": {
          "description": "Common complaint related to frequent urination"
        },
      
        "trimesterThree_commonComplaints_shortnessOfBreath": "Shortness of Breath: The baby pressing on the diaphragm can cause mild shortness of breath, especially when lying down.",
        "@trimesterThree_commonComplaints_shortnessOfBreath": {
          "description": "Common complaint related to shortness of breath"
        },
      
        "trimesterThree_commonComplaints_swelling": "Swelling: Swelling in the feet, hands, and face is common due to increased blood and fluid volume during pregnancy.",
        "@trimesterThree_commonComplaints_swelling": {
          "description": "Common complaint related to swelling"
        },
      
        "trimesterThree_commonComplaints_braxtonHicks": "Braxton Hicks Contractions: The mother may start feeling Braxton Hicks contractions, which are irregular and mild tightening of the uterus.",
        "@trimesterThree_commonComplaints_braxtonHicks": {
          "description": "Common complaint related to Braxton Hicks contractions"
        },
      
        "trimesterThree_dos_title": "What to Do",
        "@trimesterThree_dos_title": {
          "description": "Title for the section on what the mother should do"
        },
      
        "trimesterThree_dos_nutrition": "Maintain a Nutritious Diet: Continue consuming foods rich in iron, calcium, protein, and folic acid to support the baby''s development in this final stage. Increase fiber intake to prevent constipation.",
        "@trimesterThree_dos_nutrition": {
          "description": "Advice on maintaining proper nutrition"
        },
      
        "trimesterThree_dos_rest": "Get Enough Rest: Try to sleep on your left side to improve blood circulation to the baby. Use pillows between your legs or under your belly for comfort.",
        "@trimesterThree_dos_rest": {
          "description": "Advice on getting enough rest"
        },
      
        "trimesterThree_dos_monitorMovement": "Monitor Fetal Movements: Keep track of the baby''s movements daily. If there is a significant decrease in movement, consult a doctor immediately.",
        "@trimesterThree_dos_monitorMovement": {
          "description": "Advice on monitoring fetal movements"
        },
      
        "trimesterThree_dos_exercise": "Do Light Exercise: Stay active with light exercises like walking or swimming, but avoid strenuous activities or anything that could lead to a fall.",
        "@trimesterThree_dos_exercise": {
          "description": "Advice on engaging in light exercise"
        },
      
        "trimesterThree_dos_preparation": "Prepare for Labor: Start preparing for labor by attending childbirth classes and discussing your birth plan with your doctor.",
        "@trimesterThree_dos_preparation": {
          "description": "Advice on preparing for labor"
        },
      
        "trimesterThree_donts_title": "What to Avoid",
        "@trimesterThree_donts_title": {
          "description": "Title for the section on what the mother should avoid"
        },
      
        "trimesterThree_donts_ignoreMovement": "Ignoring Reduced Fetal Movement: If fetal movement decreases, contact your doctor immediately.",
        "@trimesterThree_donts_ignoreMovement": {
          "description": "Warning not to ignore reduced fetal movement"
        },
      
        "trimesterThree_donts_rawFood": "Eating Raw or Undercooked Foods: Avoid foods like sushi, undercooked meat, and raw eggs that could carry harmful bacteria.",
        "@trimesterThree_donts_rawFood": {
          "description": "Warning to avoid raw or undercooked food"
        },
      
        "trimesterThree_donts_heavyLifting": "Lifting Heavy Objects: Avoid lifting heavy objects as it can strain your back and increase the risk of preterm labor.",
        "@trimesterThree_donts_heavyLifting": {
          "description": "Warning to avoid lifting heavy objects"
        },
      
        "trimesterThree_donts_prolongedStanding": "Prolonged Standing or Sitting: Avoid standing or sitting in the same position for too long. Move around and stretch your legs to prevent swelling.",
        "@trimesterThree_donts_prolongedStanding": {
          "description": "Warning to avoid standing or sitting for too long"
        },
      
        "trimesterThree_donts_ignoreLabor": "Ignoring Signs of Labor: If you experience regular contractions, water breaking, or mucus discharge, go to the hospital immediately.",
        "@trimesterThree_donts_ignoreLabor": {
          "description": "Warning not to ignore signs of labor"
        },
      
        "trimesterThree_fetalDevelopmentImage_caption": "Fetal development during the third trimester",
        "@trimesterThree_fetalDevelopmentImage_caption": {
          "description": "Caption for the fetal development image"
        },
      
        "trimesterThree_maternalComplaintsImage_caption": "Common complaints experienced in the third trimester",
        "@trimesterThree_maternalComplaintsImage_caption": {
          "description": "Caption for the maternal complaints image"
        },
      
