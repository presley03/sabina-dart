  "preparingForLabor_title": "Preparing for Labor",
  "@preparingForLabor_title": {
    "description": "Title for the preparing for labor page"
  },
  "preparingForLabor_header": "Preparing for Labor",
  "@preparingForLabor_header": {
    "description": "Header title for the preparing for labor page"
  },
  "preparingForLabor_intro": "Preparing for labor is essential for pregnant women, their families, and close communities. This preparation includes three main aspects: preparing the mother, preparing for the baby's arrival, and preparing the family. With proper preparation, the labor process is expected to be smoother and more comfortable for everyone involved.",
  "@preparingForLabor_intro": {
    "description": "Introductory paragraph explaining the importance of labor preparation"
  },
  "preparingForLabor_motherPreparation_title": "Mother''s Preparation",
  "@preparingForLabor_motherPreparation_title": {
    "description": "Title for the mother's preparation section"
  },
  "preparingForLabor_physicalPreparation_title": "Physical Preparation",
  "@preparingForLabor_physicalPreparation_title": {
    "description": "Title for the mother's physical preparation subsection"
  },
  "preparingForLabor_physicalPreparation_exercise": "Light exercise: Engaging in light exercise such as walking, prenatal exercises, or prenatal yoga is highly recommended to strengthen pelvic muscles and help the body prepare for labor.",
  "@preparingForLabor_physicalPreparation_exercise": {
    "description": "Explanation of the importance of light exercise for physical preparation"
  },
  "preparingForLabor_physicalPreparation_nutrition": "Balanced nutrition: Ensure adequate nutrition intake, with foods rich in protein, iron, calcium, and fiber.",
  "@preparingForLabor_physicalPreparation_nutrition": {
    "description": "Explanation of the importance of balanced nutrition for physical preparation"
  },
