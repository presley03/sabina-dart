  "@dailyCare_reference1": {
    "description": "Reference 1"
  },
  "physicalActivity_screenTitle": "Physical Activity",
  "@physicalActivity_screenTitle": {
    "description": "Title for the physical activity screen for pregnant women"
  },
  "physicalActivity_introduction": "Physical activity is very important during pregnancy as it helps maintain the health of the mother and the development of the baby. By performing the right exercises, pregnant women can reduce the risk of complications, such as ==high blood pressure==, strengthen muscles for labor, and reduce discomfort like back pain.",
  "@physicalActivity_introduction": {
    "description": "Introduction text about the importance of physical activity for pregnant women"
  },
  "physicalActivity_item1_title": "Walking",
  "@physicalActivity_item1_title": {
    "description": "Title for the first physical activity item"
  },
  "physicalActivity_item1_content1": "The easiest and safest physical activity.",
  "@physicalActivity_item1_content1": {
    "description": "Content 1 for the first physical activity item"
  },
  "physicalActivity_item1_content2": "Walking for 30 minutes a day can help improve circulation and maintain fitness.",
  "@physicalActivity_item1_content2": {
    "description": "Content 2 for the first physical activity item"
  },
  "physicalActivity_item1_content3": "Try walking at a moderate pace in the morning or evening.",
  "@physicalActivity_item1_content3": {
    "description": "Content 3 for the first physical activity item"
  },
  "physicalActivity_item1_imageCaption": "Pregnant woman walking in the park",
  "@physicalActivity_item1_imageCaption": {
    "description": "Image caption for the first physical activity item"
  },
  "physicalActivity_item2_title": "Stretching",
  "@physicalActivity_item2_title": {
    "description": "Title for the second physical activity item"
  },
  "physicalActivity_item2_content1": "Helps reduce muscle tension and improve flexibility.",
  "@physicalActivity_item2_content1": {
    "description": "Content 1 for the second physical activity item"
  },
  "physicalActivity_item2_content2": "Perform light stretches for the neck, arms, and legs.",
  "@physicalActivity_item2_content2": {
    "description": "Content 2 for the second physical activity item"
  },
  "physicalActivity_item2_content3": "These simple stretches can be done daily to prevent muscle pain and tension.",
  "@physicalActivity_item2_content3": {
    "description": "Content 3 for the second physical activity item"
  },
  "physicalActivity_item2_imageCaption": "Pregnant woman doing light stretches",
  "@physicalActivity_item2_imageCaption": {
    "description": "Image caption for the second physical activity item"
  },
  "physicalActivity_item3_title": "Pregnancy Exercise",
  "@physicalActivity_item3_title": {
    "description": "Title for the third physical activity item"
  },
  "physicalActivity_item3_content1": "Specifically designed for pregnant women.",
  "@physicalActivity_item3_content1": {
    "description": "Content 1 for the third physical activity item"
  },
  "physicalActivity_item3_content2": "Includes movements that help strengthen pelvic, back, and abdominal muscles.",
  "@physicalActivity_item3_content2": {
    "description": "Content 2 for the third physical activity item"
  },
  "physicalActivity_item3_content3": "Can help the mother relax and prepare for labor.",
  "@physicalActivity_item3_content3": {
    "description": "Content 3 for the third physical activity item"
  },
  "physicalActivity_item4_title": "Prenatal Yoga",
  "@physicalActivity_item4_title": {
    "description": "Title for the fourth physical activity item"
  },
  "physicalActivity_item4_content1": "Safe for pregnant women as it focuses on breathing, balance, and stretching.",
  "@physicalActivity_item4_content1": {
    "description": "Content 1 for the fourth physical activity item"
  },
  "physicalActivity_item4_content2": "Helps the mother to relax and manage stress.",
  "@physicalActivity_item4_content2": {
    "description": "Content 2 for the fourth physical activity item"
  },
  "physicalActivity_item4_content3": "Can be done in classes or at home with the guidance of an experienced instructor.",
  "@physicalActivity_item4_content3": {
    "description": "Content 3 for the fourth physical activity item"
  },
  "physicalActivity_item4_imageCaption": "Pregnant woman doing a prenatal yoga pose",
  "@physicalActivity_item4_imageCaption": {
    "description": "Image caption for the fourth physical activity item"
  },
  "physicalActivity_item5_title": "Swimming",
  "@physicalActivity_item5_title": {
    "description": "Title for the fifth physical activity item"
  },
  "physicalActivity_item5_content1": "Excellent for pregnant women because water supports body weight, reducing pressure on the joints.",
  "@physicalActivity_item5_content1": {
    "description": "Content 1 for the fifth physical activity item"
  },
  "physicalActivity_item5_content2": "Helps improve circulation and reduce swelling in the legs.",
  "@physicalActivity_item5_content2": {
    "description": "Content 2 for the fifth physical activity item"
  },
  "physicalActivity_item5_content3": "Make sure the pool is clean and safe.",
  "@physicalActivity_item5_content3": {
    "description": "Content 3 for the fifth physical activity item"
  },
  "physicalActivity_tipsTitle": "Things to Keep in Mind:",
  "@physicalActivity_tipsTitle": {
    "description": "Title for the tips section"
  },
  "physicalActivity_tip1": "Consult your doctor before starting any new physical activity.",
  "@physicalActivity_tip1": {
    "description": "Tip 1"
  },
  "physicalActivity_tip2": "Avoid exercises that could cause falls or affect balance.",
  "@physicalActivity_tip2": {
    "description": "Tip 2"
  },
  "physicalActivity_tip3": "Do not overexert yourself, and stop if you feel dizzy, tired, or have difficulty breathing.",
  "@physicalActivity_tip3": {
    "description": "Tip 3"
  },
  "physicalActivity_tip4": "Drink enough water before and after exercising to prevent dehydration.",
  "@physicalActivity_tip4": {
    "description": "Tip 4"
  },
  "physicalActivity_referencesTitle": "References",
  "@physicalActivity_referencesTitle": {
    "description": "Title for the references section"
  },
