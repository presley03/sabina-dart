                    "dailyCare_screenTitle": "Perawatan Sehari-hari",
                    "@dailyCare_screenTitle": {
                      "description": "Judul untuk layar perawatan sehari-hari"
                    },
                  
                    "dailyCare_introduction": "Perawatan sehari-hari sangat penting bagi ibu hamil untuk menjaga kesehatan diri dan janin. Berikut adalah panduan perawatan sehari-hari untuk ibu hamil:",
                    "@dailyCare_introduction": {
                      "description": "Teks pengantar tentang pentingnya perawatan sehari-hari untuk ibu hamil"
                    },
                  
                    "dailyCare_item1_title": "Makan Beragam Makanan",
                    "@dailyCare_item1_title": {
                      "description": "Judul untuk item perawatan pertama"
                    },
                  
                    "dailyCare_item1_content1": "Konsumsi makanan lengkap: Karbohidrat, Protein, Sayuran, Buah-buahan.",
                    "@dailyCare_item1_content1": {
                      "description": "Konten 1 untuk item perawatan pertama"
                    },
                  
                    "dailyCare_item1_content2": "Minum ==Tablet Tambah Darah (TTD)== setiap hari.",
                    "@dailyCare_item1_content2": {
                      "description": "Konten 2 untuk item perawatan pertama"
                    },
                  
                    "dailyCare_item1_content3": "Batasi gula dan garam.",
                    "@dailyCare_item1_content3": {
                      "description": "Konten 3 untuk item perawatan pertama"
                    },
                  
                    "dailyCare_item1_content4": "Minum 8-12 gelas air putih per hari.",
                    "@dailyCare_item1_content4": {
                      "description": "Konten 4 untuk item perawatan pertama"
                    },
                  
                    "dailyCare_item2_title": "Jaga Kebersihan Diri",
                    "@dailyCare_item2_title": {
                      "description": "Judul untuk item perawatan kedua"
                    },
                  
                    "dailyCare_item2_content1": "Cuci tangan dengan sabun dan air mengalir.",
                    "@dailyCare_item2_content1": {
                      "description": "Konten 1 untuk item perawatan kedua"
                    },
                  
                    "dailyCare_item2_content2": "Mandi dan gosok gigi 2 kali sehari.",
                    "@dailyCare_item2_content2": {
                      "description": "Konten 2 untuk item perawatan kedua"
                    },
                  
                    "dailyCare_item2_content3": "Keramas setiap 2 hari sekali.",
                    "@dailyCare_item2_content3": {
                      "description": "Konten 3 untuk item perawatan kedua"
                    },
                  
                    "dailyCare_item2_content4": "Jaga kebersihan payudara dan area intim.",
                    "@dailyCare_item2_content4": {
                      "description": "Konten 4 untuk item perawatan kedua"
                    },
                  
                    "dailyCare_item2_content5": "Ganti pakaian dan pakaian dalam secara teratur.",
                    "@dailyCare_item2_content5": {
                      "description": "Konten 5 untuk item perawatan kedua"
                    },
                  
                    "dailyCare_item3_title": "Istirahat Cukup",
                    "@dailyCare_item3_title": {
                      "description": "Judul untuk item perawatan ketiga"
                    },
                  
                    "dailyCare_item3_content1": "Tidur malam 6-7 jam.",
                    "@dailyCare_item3_content1": {
                      "description": "Konten 1 untuk item perawatan ketiga"
                    },
                  
                    "dailyCare_item3_content2": "Istirahat siang 1-2 jam.",
                    "@dailyCare_item3_content2": {
                      "description": "Konten 2 untuk item perawatan ketiga"
                    },
                  
                    "dailyCare_item4_title": "Stimulasi Janin",
                    "@dailyCare_item4_title": {
                      "description": "Judul untuk item perawatan keempat"
                    },
                  
                    "dailyCare_item4_content1": "Sentuh perut ibu.",
                    "@dailyCare_item4_content1": {
                      "description": "Konten 1 untuk item perawatan keempat"
                    },
                  
                    "dailyCare_item4_content2": "Ajak janin berbicara.",
                    "@dailyCare_item4_content2": {
                      "description": "Konten 2 untuk item perawatan keempat"
                    },
                  
                    "dailyCare_item4_content3": "Bacakan buku untuk janin.",
                    "@dailyCare_item4_content3": {
                      "description": "Konten 3 untuk item perawatan keempat"
                    },
                  
                    "dailyCare_item4_content4": "Lakukan bersama suami.",
