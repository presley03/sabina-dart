        "trimesterThree_week28_29": "Minggu 28-29",
        "@trimesterThree_week28_29": {
          "description": "Label untuk minggu 28-29"
        },
      
        "trimesterThree_week28_29_desc": "Ukuran janin: Sekitar 38-40 cm, berat sekitar 1-1,3 kg. Janin terus bertambah berat, dan paru-paru serta otak berkembang pesat. Mata janin sudah bisa berkedip dan merespons cahaya. Lemak mulai menumpuk di bawah kulit, memberikan janin tampilan lebih gemuk.",
        "@trimesterThree_week28_29_desc": {
          "description": "Deskripsi perkembangan janin pada minggu 28-29"
        },
      
        "trimesterThree_week30_31": "Minggu 30-31",
        "@trimesterThree_week30_31": {
          "description": "Label untuk minggu 30-31"
        },
      
        "trimesterThree_week30_31_desc": "Ukuran janin: Sekitar 40-42 cm, berat sekitar 1,4-1,6 kg. Janin mulai lebih aktif dan ibu mungkin merasakan tendangan yang lebih kuat. Pendengaran janin sudah sangat berkembang, sehingga dapat merespons suara, baik dari dalam maupun luar rahim.",
        "@trimesterThree_week30_31_desc": {
          "description": "Deskripsi perkembangan janin pada minggu 30-31"
        },
      
        "trimesterThree_week32_33": "Minggu 32-33",
