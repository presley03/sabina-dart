                      "physicalActivity_screenTitle": "Aktivitas Fisik Ibu Hamil",
                      "@physicalActivity_screenTitle": {
                        "description": "Judul untuk layar aktivitas fisik ibu hamil"
                      },
                    
                      "physicalActivity_introduction": "Aktivitas fisik sangat penting selama kehamilan karena membantu menjaga kesehatan ibu dan perkembangan janin. Dengan melakukan latihan yang tepat, ibu hamil dapat mengurangi risiko komplikasi, seperti ==tekanan darah tinggi==, memperkuat otot untuk persalinan, dan mengurangi rasa tidak nyaman seperti sakit punggung.",
                      "@physicalActivity_introduction": {
                        "description": "Teks pengantar tentang pentingnya aktivitas fisik untuk ibu hamil"
                      },
                    
                      "physicalActivity_item1_title": "Jalan Kaki",
                      "@physicalActivity_item1_title": {
                        "description": "Judul untuk item aktivitas pertama"
                      },
                    
                      "physicalActivity_item1_content1": "Aktivitas fisik yang paling mudah dan aman.",
                      "@physicalActivity_item1_content1": {
                        "description": "Konten 1 untuk item aktivitas pertama"
                      },
                    
                      "physicalActivity_item1_content2": "Jalan kaki selama 30 menit setiap hari dapat membantu melancarkan peredaran darah dan menjaga kebugaran.",
                      "@physicalActivity_item1_content2": {
                        "description": "Konten 2 untuk item aktivitas pertama"
                      },
                    
                      "physicalActivity_item1_content3": "Cobalah untuk berjalan di pagi atau sore hari dengan kecepatan sedang.",
                      "@physicalActivity_item1_content3": {
                        "description": "Konten 3 untuk item aktivitas pertama"
                      },
                    
                      "physicalActivity_item1_imageCaption": "Ibu hamil berjalan kaki di taman",
                      "@physicalActivity_item1_imageCaption": {
                        "description": "Keterangan gambar untuk item aktivitas pertama"
