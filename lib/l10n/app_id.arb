                  "avoidScreen_title": "Yang Perlu Dihindari",
                  "@avoidScreen_title": {
                    "description": "Judul untuk halaman yang perlu dihindari"
                  },
                
                  "avoidScreen_introduction": "Selama kehamilan, ada beberapa hal yang perlu dihindari untuk menjaga kesehatan ibu dan janin. Berikut adalah panduan tentang hal-hal yang sebaiknya dihindari selama kehamilan:",
                  "@avoidScreen_introduction": {
                    "description": "Teks pengantar tentang hal-hal yang perlu dihindari selama kehamilan"
                  },
                
                  "avoidScreen_alcohol_title": "Mengonsumsi Alkohol",
                  "@avoidScreen_alcohol_title": {
                    "description": "Judul untuk item alkohol"
                  },
                
                  "avoidScreen_alcohol_content": "Mengonsumsi alkohol selama kehamilan dapat menyebabkan cacat lahir, masalah pertumbuhan, dan gangguan perkembangan otak pada bayi.",
                  "@avoidScreen_alcohol_content": {
                    "description": "Penjelasan tentang bahaya mengonsumsi alkohol selama kehamilan"
                  },
                
                  "avoidScreen_smoking_title": "Merokok",
                  "@avoidScreen_smoking_title": {
                    "description": "Judul untuk item merokok"
                  },
                
                  "avoidScreen_smoking_content": "Merokok selama kehamilan meningkatkan risiko kelahiran prematur, berat badan lahir rendah, dan masalah pernapasan pada bayi. Juga meningkatkan risiko kematian mendadak pada bayi (==SIDS==).",
                  "@avoidScreen_smoking_content": {
                    "description": "Penjelasan tentang bahaya merokok selama kehamilan"
                  },
                
                  "avoidScreen_caffeine_title": "Mengkonsumsi Kafein Berlebihan",
                  "@avoidScreen_caffeine_title": {
                    "description": "Judul untuk item kafein berlebihan"
                  },
                
                  "avoidScreen_caffeine_content": "Asupan kafein yang berlebihan selama kehamilan dapat meningkatkan risiko keguguran dan berat badan lahir rendah. Sebaiknya, batasi konsumsi kafein maksimal ==200 mg per hari== (sekitar satu cangkir kopi).",
                  "@avoidScreen_caffeine_content": {
                    "description": "Penjelasan tentang bahaya mengonsumsi kafein berlebihan selama kehamilan"
                  },
                
                  "avoidScreen_drugs_title": "Paparan Obat-obatan Terlarang",
                  "@avoidScreen_drugs_title": {
                    "description": "Judul untuk item obat-obatan terlarang"
                  },
                
                  "avoidScreen_drugs_content": "Penggunaan obat-obatan terlarang seperti kokain, amfetamin, dan heroin selama kehamilan dapat menyebabkan kelahiran prematur, cacat lahir, dan masalah perilaku serta perkembangan pada bayi.",
                  "@avoidScreen_drugs_content": {
                    "description": "Penjelasan tentang bahaya paparan obat-obatan terlarang selama kehamilan"
                  },
                
                  "avoidScreen_rawFood_title": "Makanan Mentah atau Setengah Matang",
                  "@avoidScreen_rawFood_title": {
                    "description": "Judul untuk item makanan mentah atau setengah matang"
                  },
                
                  "avoidScreen_rawFood_content": "Ibu hamil harus menghindari konsumsi makanan mentah atau setengah matang seperti sushi, telur mentah, daging setengah matang, dan susu yang tidak dipasteurisasi karena berisiko menyebabkan infeksi bakteri seperti listeria.",
                  "@avoidScreen_rawFood_content": {
                    "description": "Penjelasan tentang bahaya mengonsumsi makanan mentah atau setengah matang selama kehamilan"
                  },
                
                  "avoidScreen_highMercuryFish_title": "Mengonsumsi Ikan Tinggi Merkuri",
                  "@avoidScreen_highMercuryFish_title": {
                    "description": "Judul untuk item ikan tinggi merkuri"
                  },
                
                  "avoidScreen_highMercuryFish_content": "Ikan yang mengandung kadar merkuri tinggi, seperti hiu, ikan pedang, dan tuna sirip biru, dapat memengaruhi perkembangan sistem saraf bayi. Sebaiknya ibu hamil memilih ikan yang rendah merkuri.",
                  "@avoidScreen_highMercuryFish_content": {
                    "description": "Penjelasan tentang bahaya mengonsumsi ikan tinggi merkuri selama kehamilan"
                  },
                
                  "avoidScreen_chemicals_title": "Penggunaan Produk Kimia Berbahaya",
                  "@avoidScreen_chemicals_title": {
                    "description": "Judul untuk item produk kimia berbahaya"
                  },
                
                  "avoidScreen_chemicals_content": "Hindari penggunaan produk kimia rumah tangga yang keras seperti pembersih berbahan dasar amonia, pemutih, dan insektisida. Paparan terhadap bahan kimia ini dapat berisiko terhadap kesehatan ibu dan janin.",
                  "@avoidScreen_chemicals_content": {
                    "description": "Penjelasan tentang bahaya penggunaan produk kimia berbahaya selama kehamilan"
                  },
                
                  "avoidScreen_heavyLifting_title": "Mengangkat Benda Berat",
                  "@avoidScreen_heavyLifting_title": {
                    "description": "Judul untuk item mengangkat benda berat"
                  },
                
                  "avoidScreen_heavyLifting_content": "Ibu hamil sebaiknya tidak mengangkat benda yang terlalu berat karena bisa menyebabkan cedera punggung, ketegangan otot, dan meningkatkan risiko keguguran, terutama pada awal kehamilan.",
                  "@avoidScreen_heavyLifting_content": {
                    "description": "Penjelasan tentang bahaya mengangkat benda berat selama kehamilan"
                  },
                
                  "avoidScreen_lackOfRest_title": "Mengabaikan Istirahat yang Cukup",
                  "@avoidScreen_lackOfRest_title": {
                    "description": "Judul untuk item kurang istirahat"
                  },
                
                  "avoidScreen_lackOfRest_content": "Kehamilan menyebabkan perubahan besar pada tubuh, sehingga ibu hamil perlu banyak istirahat. Kurang tidur dapat menyebabkan stres, kelelahan, dan berpotensi menimbulkan komplikasi seperti tekanan darah tinggi atau ==preeklampsia==.",
                  "@avoidScreen_lackOfRest_content": {
                    "description": "Penjelasan tentang bahaya kurang istirahat selama kehamilan"
                  },
                
                  "avoidScreen_stress_title": "Stres Berlebihan",
                  "@avoidScreen_stress_title": {
                    "description": "Judul untuk item stres berlebihan"
                  },
                
                  "avoidScreen_stress_content": "Stres berlebihan dapat memengaruhi kesehatan ibu hamil dan janin. Tingkat stres yang tinggi selama kehamilan dapat meningkatkan risiko kelahiran prematur, berat badan lahir rendah, dan masalah perilaku pada bayi di kemudian hari.",
                  "@avoidScreen_stress_content": {
                    "description": "Penjelasan tentang bahaya stres berlebihan selama kehamilan"
                  },
                
                  "avoidScreen_tips_title": "Tips Kehamilan Sehat",
                  "@avoidScreen_tips_title": {
                    "description": "Judul untuk bagian tips kehamilan sehat"
                  },
                
                  "avoidScreen_tips_content": "Untuk menjaga kehamilan yang sehat, selalu konsultasikan dengan dokter atau bidan Anda tentang gaya hidup dan pola makan yang tepat. Jika Anda memiliki kekhawatiran atau pertanyaan, jangan ragu untuk menghubungi profesional kesehatan.",
                  "@avoidScreen_tips_content": {
                    "description": "Konten untuk tips kehamilan sehat"
                  },
                
                  "avoidScreen_moreTips": "Lihat Tips Lainnya",
                  "@avoidScreen_moreTips": {
                    "description": "Teks untuk tombol lihat tips lainnya"
                  },
                
                  "avoidScreen_additionalTips_title": "Tips Tambahan untuk Kehamilan Sehat",
                  "@avoidScreen_additionalTips_title": {
                    "description": "Judul untuk bagian tips tambahan"
                  },
                
                  "avoidScreen_additionalTip1": "Makan makanan kaya asam folat seperti sayuran hijau dan kacang-kacangan.",
                  "@avoidScreen_additionalTip1": {
                    "description": "Tip tambahan 1"
                  },
                
                  "avoidScreen_additionalTip2": "Lakukan olahraga ringan seperti berjalan kaki atau yoga prenatal.",
                  "@avoidScreen_additionalTip2": {
                    "description": "Tip tambahan 2"
                  },
                
                  "avoidScreen_additionalTip3": "Hindari paparan asap rokok dan polusi udara.",
                  "@avoidScreen_additionalTip3": {
                    "description": "Tip tambahan 3"
                  },
                
                  "avoidScreen_additionalTip4": "Rutin periksa kehamilan sesuai jadwal yang ditentukan oleh dokter atau bidan.",
                  "@avoidScreen_additionalTip4": {
                    "description": "Tip tambahan 4"
                  },
                
                  "avoidScreen_additionalTip5": "Jaga kebersihan dengan rajin mencuci tangan dan mandi.",
                  "@avoidScreen_additionalTip5": {
                    "description": "Tip tambahan 5"
                  },
                
                  "avoidScreen_additionalTip6": "Gunakan pelembab untuk mencegah stretch marks.",
                  "@avoidScreen_additionalTip6": {
                    "description": "Tip tambahan 6"
                  },
                
                  "avoidScreen_additionalTip7": "Konsumsi suplemen prenatal sesuai anjuran dokter.",
                  "@avoidScreen_additionalTip7": {
                    "description": "Tip tambahan 7"
                  },
                
                  "avoidScreen_additionalTip8": "Lakukan teknik relaksasi untuk mengurangi stres.",
                  "@avoidScreen_additionalTip8": {
                    "description": "Tip tambahan 8"
                  },
                
                  "avoidScreen_additionalTip9": "Tidur miring ke kiri untuk meningkatkan sirkulasi darah ke janin.",
                  "@avoidScreen_additionalTip9": {
                    "description": "Tip tambahan 9"
                  },
                
                  "avoidScreen_additionalTip10": "Hindari penggunaan jacuzzi atau sauna yang dapat meningkatkan suhu tubuh.",
                  "@avoidScreen_additionalTip10": {
                    "description": "Tip tambahan 10"
                  },
                
                  "avoidScreen_additionalTip11": "Pastikan vaksinasi Anda lengkap sesuai rekomendasi dokter.",
                  "@avoidScreen_additionalTip11": {
                    "description": "Tip tambahan 11"
                  },
                
                  "avoidScreen_additionalTip12": "Konsumsi air putih yang cukup, minimal 8 gelas per hari.",
                  "@avoidScreen_additionalTip12": {
                    "description": "Tip tambahan 12"
                  },
                
                  "avoidScreen_additionalTip13": "Pilih pakaian yang nyaman dan tidak terlalu ketat.",
                  "@avoidScreen_additionalTip13": {
                    "description": "Tip tambahan 13"
                  },
                
                  "avoidScreen_additionalTip14": "Lakukan perawatan gigi rutin untuk mencegah masalah gusi.",
                  "@avoidScreen_additionalTip14": {
                    "description": "Tip tambahan 14"
                  },
                
